# LH Short Bot - every credential in one file (3.11).
# Keep this file next to LHShortBot.exe (or lh_short_bot_app.py). Never share it, never upload it.
# One KEY=VALUE per line, no quotes needed. An empty value = not set. Lines starting with # are comments.

# TradeZero (orders, locates, positions). Keys: click "Keys" in the app, or a tradezero.json file
# next to the app: {"api_key_id": "...", "api_secret": "...", "account_id": "", "route": ""}

# TradeZero Developer API keys (paper keys trade the paper account, live keys the live account)
TZ_API_KEY_ID=
TZ_API_SECRET=
# Account ID: empty = the first account these keys can see
TZ_ACCOUNT_ID=
# Route: empty = TradeZero's default (paper: PAPER)
TZ_ROUTE=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Ping on urgent messages: @everyone, <@your user id> or empty
DISCORD_MENTION=

# IB Gateway (live 4001, paper 4002; TWS 7496 / 7497)
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=101

# Your IB data vault (market_data_vault.db), read only - older days load from it first. Empty = not used
VAULT_DB=

# Turso cloud database (3.14): settings, favorites, watchlist, backtests, notes, journals and the data vault live there,
# so every PC shows the same. Turso dashboard -> your database -> URL and "Create token". Empty = this PC's own files only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Live trading is NOT switched on here: it needs ALLOW_LIVE_TRADING = True in lh_short_bot_app.py.
